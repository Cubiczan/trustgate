# T3N API Configuration
# Read server-side by src/lib/t3-client.ts. Keep the API key server-only
# (do NOT expose it via a NEXT_PUBLIC_* variable).
T3_API_BASE=https://api.terminal3.io
T3_API_KEY=your_api_token_here

# Bearer token gating the destructive /api/demo/seed endpoint.
# If unset, the seed endpoint fails closed (503) and refuses to run.
DEMO_SEED_TOKEN=
